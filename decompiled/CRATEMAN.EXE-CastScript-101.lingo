on mouseUp
  global puzzle
  if puzzle <> 0 then
    repeat with n = 12 to 15
      set the locH of sprite n to -2000
      set the locV of sprite n to -2000
    end repeat
  end if
  puppetSound("click5.wav")
  updateStage()
  set the keyUpScript to EMPTY
  play frame "soleau"
  if puzzle <> 0 then
    set the keyUpScript to "getdir"
  end if
end
